{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.1",
  "id": "db36fbf6-6c31-4f41-a5c2-b4546f209c57",
  "developer": {
    "name": "Voice Support",
    "websiteUrl": "https://ht-demo-mcp.onrender.com/teams/index.html",
    "privacyUrl": "https://ht-demo-mcp.onrender.com/teams/privacy.html",
    "termsOfUseUrl": "https://ht-demo-mcp.onrender.com/teams/terms.html"
  },
  "name": {
    "short": "HT Voice Support",
    "full": "HT Voice Support – ElevenLabs agents"
  },
  "description": {
    "short": "Glasovni razgovor s agentima korisničke podrške.",
    "full": "Neovisna aplikacija s dva ElevenLabs glasovna agenta. Koristite samo sintetičke podatke. Za glasovni razgovor potrebna je dozvola za mikrofon."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#E20074",
  "configurableTabs": [
    {
      "configurationUrl": "https://ht-demo-mcp.onrender.com/teams/config.html",
      "canUpdateConfiguration": true,
      "scopes": [
        "team",
        "groupchat"
      ],
      "context": [
        "channelTab",
        "privateChatTab"
      ]
    }
  ],
  "devicePermissions": [
    "media"
  ],
  "validDomains": [
    "ht-demo-mcp.onrender.com",
    "res.cdn.office.net",
    "unpkg.com",
    "elevenlabs.io",
    "*.elevenlabs.io",
    "*.livekit.cloud"
  ]
}
